#!/usr/bin/env bash
#MISE description="📦 Prepare the distribution folder for the npm package"
#MISE depends=["js:build"]

set -euo pipefail

# Get version from sbt
# sbt 2's thin client appends a trailing ANSI clear-line sequence after stdout, which
# `tail -n 1` would otherwise capture instead of the version — filter for the semver shape.
VERSION=$(sbt -no-colors --error 'print version' | grep -E '^[0-9]+\.[0-9]+\.[0-9]+(-SNAPSHOT)?$' | tail -n 1)
CLEAN_VERSION=$(echo "$VERSION" | sed 's/-SNAPSHOT//')

# Create distribution directory
mkdir -p dist

# Sync version in the root package.json
sed -i.bak "s/\"version\": \"[^\"]*\"/\"version\": \"$CLEAN_VERSION\"/" package.json
rm package.json.bak

# Copy assets to the distribution folder (sbt 2's shared target/out/ layout, not js/target/)
cp target/out/sjs1/scala-3.*/dicechess-engine-scala/dicechess-engine-scala-opt/main.js dist/dicechess-engine.js
cp js/dicechess-engine.d.ts dist/
cp js/README.md dist/README.md

# Compile optimized package.json for NPM publication (flattened paths, no 'files' field needed)
jq --arg ver "$CLEAN_VERSION" '
  .version = $ver |
  .main = "dicechess-engine.js" |
  .types = "dicechess-engine.d.ts" |
  del(.files)
' package.json > dist/package.json
