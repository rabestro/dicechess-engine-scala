#!/usr/bin/env bash
#MISE description="📦 Prepare the distribution folder for the npm package"
#MISE depends=["js:build"]

set -euo pipefail

# Get version from sbt.
#
# Scoped to rootJVM and matched anywhere in the output, both deliberately. An unscoped
# `print version` prints one line *per project* once the release workflow has run
# `set ThisBuild / version := ...`:
#     rootJVM / version	1.11.5
#     rootJS / version	1.11.5
# so an anchored `^semver$` filter matches nothing, grep exits 1, and `pipefail` kills this
# script silently — which is exactly how the v1.11.5 release lost its npm packages.
# `|| true` keeps the pipeline alive so the emptiness check below can report it properly.
VERSION=$(sbt -no-colors --error 'print rootJVM/version' | grep -oE '[0-9]+\.[0-9]+\.[0-9]+(-SNAPSHOT)?' | head -n 1 || true)
if [[ -z "$VERSION" ]]; then
  echo "error: could not determine the project version from sbt" >&2
  echo "       'print rootJVM/version' produced no semver-looking output" >&2
  exit 1
fi
CLEAN_VERSION=$(echo "$VERSION" | sed 's/-SNAPSHOT//')

# Create distribution directory
mkdir -p dist

# Sync version in the root package.json
sed -i.bak "s/\"version\": \"[^\"]*\"/\"version\": \"$CLEAN_VERSION\"/" package.json
rm package.json.bak

# Copy assets to the distribution folder (sbt 2's shared target/out/ layout, not js/target/)
cp target/out/sjs1/scala-3.*/dicechess-engine-scala/dicechess-engine-scala-opt/main.js dist/dicechess-engine.js
cp js/dicechess-engine.d.ts dist/
cp js/README.md dist/README.md

# Compile optimized package.json for NPM publication (flattened paths, no 'files' field needed)
jq --arg ver "$CLEAN_VERSION" '
  .version = $ver |
  .main = "dicechess-engine.js" |
  .types = "dicechess-engine.d.ts" |
  del(.files)
' package.json > dist/package.json
